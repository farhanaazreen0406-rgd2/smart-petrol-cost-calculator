<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kalkulator Petrol"
            android:textColor="#38BDF8"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jenis Petrol:"
                    android:textColor="#94A3B8"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/rgPetrolType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/rbRon95"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RON95"
                        android:textColor="#F8FAFC"
                        android:buttonTint="#38BDF8"
                        android:checked="true"/>

                    <RadioButton
                        android:id="@+id/rbRon97"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RON97"
                        android:textColor="#F8FAFC"
                        android:buttonTint="#38BDF8"
                        android:layout_marginStart="12dp"/>

                    <RadioButton
                        android:id="@+id/rbDiesel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diesel"
                        android:textColor="#F8FAFC"
                        android:buttonTint="#38BDF8"
                        android:layout_marginStart="12dp"/>
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="#94A3B8"
                    app:boxStrokeColor="#38BDF8"
                    app:hintTextColor="#38BDF8"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPricePerLiter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Harga Seliter (RM) contoh: 2.05"
                        android:inputType="numberDecimal"
                        android:textColor="#F8FAFC"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="#94A3B8"
                    app:boxStrokeColor="#38BDF8"
                    app:hintTextColor="#38BDF8"
                    android:layout_marginBottom="24dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFuelUsage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Penggunaan Bahan Api (Liter)"
                        android:inputType="numberDecimal"
                        android:textColor="#F8FAFC"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBudi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Layak BUDI MADANI?"
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    app:thumbTint="#38BDF8"
                    app:trackTint="#64748B"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Kira Kos Semasa"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="#38BDF8"
            android:textColor="#0F172A"
            android:layout_marginBottom="24dp"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#10B981"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ringkasan Kos"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvTotalCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jumlah Kos Petrol: RM 0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvBudiRebate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rebat BUDI: RM 0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#A7F3D0"
                    android:layout_marginVertical="8dp"/>

                <TextView
                    android:id="@+id/tvTotalSaving"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jumlah Penjimatan (Yang Perlu Dibayar): RM 0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareResult"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Kongsi Keputusan"
                    android:textColor="#10B981"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="12dp"
                    android:layout_marginTop="16dp"
                    android:textAllCaps="false"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconTint="#10B981"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>